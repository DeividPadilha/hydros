hydros:EvidenciaClimatica a owl:Class ;
    rdfs:label "Evidência climática"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaClimatica_U2_P4 a hydros:EvidenciaClimatica,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaClimatica U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:EvidenciaContextual a owl:Class ;
    rdfs:label "Evidência contextual"@pt ;
