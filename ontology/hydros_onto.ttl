@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix hydros: <http://www.semanticweb.org/deivid/hydrosonto#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://www.semanticweb.org/deivid/hydrosonto> a owl:Ontology ;
    dcterms:created "2026-08-11"^^xsd:date ;
    dcterms:creator "Deivid de Almeida Padilha da Silva" ;
    dcterms:title "HydrosOnto: Ontologia de Domínio para Gerenciamento Hídrico Agrícola"@pt ;
    owl:versionInfo "0.1 - versão mínima para qualificação" .

hydros:AIEC a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Integrador de Evidências Contextuais"@pt ;
    hydros:produzEvidencia hydros:EvidenciaContextual_U2_P4 .

hydros:AMDH a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Motor de Decisão Híbrido"@pt ;
    hydros:determinaAcao hydros:Acao_U2_P4 .

hydros:APS a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Preditivo Supervisionado"@pt ;
    hydros:produzEvidencia hydros:EvidenciaPreditiva_U2_P4 .

hydros:ARG a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente de Regras Agronômicas"@pt ;
    hydros:aplicaRegra hydros:Regra_Condicao_Adequada,
        hydros:Regra_Condicao_Atencao,
        hydros:Regra_Condicao_Critica ;
    hydros:produzEvidencia hydros:EvidenciaAgronomica_U2_P4 .

hydros:Aclim a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Climático"@pt ;
    hydros:produzEvidencia hydros:EvidenciaClimatica_U2_P4 .

hydros:Afen a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Fenológico"@pt ;
    hydros:produzEvidencia hydros:EvidenciaFenologica_U2_P4 .

hydros:Ageo a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Geográfico"@pt ;
    hydros:produzEvidencia hydros:EvidenciaGeografica_U2_P4 .

hydros:Ahid a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Hídrico"@pt ;
    hydros:produzEvidencia hydros:EvidenciaHidrica_U2_P4 .

hydros:Ahist a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Histórico Contextual"@pt ;
    hydros:produzEvidencia hydros:EvidenciaHistorica_U2_P4 .

hydros:Aprod a hydros:AgenteInteligente,
        owl:NamedIndividual ;
    rdfs:label "Agente Produtivo"@pt ;
    hydros:produzEvidencia hydros:EvidenciaProdutiva_U2_P4 .

hydros:Propriedade_Exemplo_60ha a hydros:PropriedadeAgricola,
        owl:NamedIndividual ;
    rdfs:label "Propriedade exemplo de 60 ha"@pt ;
    hydros:possuiTalhao hydros:Talhao_1,
        hydros:Talhao_2,
        hydros:Talhao_3,
        hydros:Talhao_4 ;
    hydros:possuiUnidadeManejo hydros:U_1,
        hydros:U_2,
        hydros:U_3,
        hydros:U_4 .

hydros:acaoAssociadaARegra a owl:ObjectProperty ;
    rdfs:label "ação associada à regra"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:RegraAgronomica .

hydros:acaoConsideraCondicao a owl:ObjectProperty ;
    rdfs:label "ação considera condição"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:CondicaoHidrica .

hydros:acaoConsideraContexto a owl:ObjectProperty ;
    rdfs:label "ação considera contexto"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:ContextoAgricola .

hydros:acaoFundamentadaPorEvidencia a owl:ObjectProperty ;
    rdfs:label "ação fundamentada por evidência"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:Evidencia .

hydros:aguaDisponivel a owl:DatatypeProperty ;
    rdfs:label "água disponível"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:aplicaRegra a owl:ObjectProperty ;
    rdfs:label "aplica regra"@pt ;
    rdfs:domain hydros:AgenteInteligente ;
    rdfs:range hydros:RegraAgronomica .

hydros:associadaATalhao a owl:ObjectProperty ;
    rdfs:label "associada a talhão"@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:Talhao .

hydros:coeficienteCultura a owl:DatatypeProperty ;
    rdfs:label "coeficiente de cultura"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:estagioFenologico a owl:DatatypeProperty ;
    rdfs:label "estágio fenológico"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:string .

hydros:estresseHidrico a owl:DatatypeProperty ;
    rdfs:label "estresse hídrico"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:boolean .

hydros:evapotranspiracao a owl:DatatypeProperty ;
    rdfs:label "evapotranspiração"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:evidenciaConsideraContexto a owl:ObjectProperty ;
    rdfs:label "evidência considera contexto"@pt ;
    rdfs:domain hydros:Evidencia ;
    rdfs:range hydros:ContextoAgricola .

hydros:evidenciaSobre a owl:ObjectProperty ;
    rdfs:label "evidência sobre"@pt ;
    rdfs:domain hydros:Evidencia ;
    rdfs:range hydros:UnidadeManejo .

hydros:grausDia a owl:DatatypeProperty ;
    rdfs:label "graus-dia"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:irrigacaoAplicada a owl:DatatypeProperty ;
    rdfs:label "irrigação aplicada"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:possuiCondicaoHidrica a owl:ObjectProperty ;
    rdfs:label "possui condição hídrica"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range hydros:CondicaoHidrica .

hydros:possuiCultura a owl:ObjectProperty ;
    rdfs:label "possui cultura"@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:Cultura .

hydros:possuiLocalizacao a owl:ObjectProperty ;
    rdfs:label "possui localização"@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:Localizacao .

hydros:possuiSolo a owl:ObjectProperty ;
    rdfs:label "possui solo"@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:Solo .

hydros:possuiTalhao a owl:ObjectProperty ;
    rdfs:label "possui talhão"@pt ;
    rdfs:domain hydros:PropriedadeAgricola ;
    rdfs:range hydros:Talhao .

hydros:possuiUnidadeManejo a owl:ObjectProperty ;
    rdfs:label "possui unidade de manejo"@pt ;
    rdfs:domain hydros:PropriedadeAgricola ;
    rdfs:range hydros:UnidadeManejo .

hydros:precipitacao a owl:DatatypeProperty ;
    rdfs:label "precipitação"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:produtividadeEstimada a owl:DatatypeProperty ;
    rdfs:label "produtividade estimada"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:refereSeAUnidadeManejo a owl:ObjectProperty ;
    rdfs:label "refere-se à unidade de manejo"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range hydros:UnidadeManejo ;
    owl:inverseOf hydros:possuiContextoDaUnidade .

hydros:temperaturaMedia a owl:DatatypeProperty ;
    rdfs:label "temperatura média"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:umidadeSolo a owl:DatatypeProperty ;
    rdfs:label "umidade do solo"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:decimal .

hydros:Acao_U2_P4 a hydros:AcaoManejoHidrico,
        hydros:IniciarIrrigacao,
        owl:NamedIndividual ;
    rdfs:label "Ação U2 P4: iniciar irrigação"@pt ;
    hydros:acaoAssociadaARegra hydros:Regra_Condicao_Critica ;
    hydros:acaoConsideraCondicao hydros:Condicao_U2_P4 ;
    hydros:acaoConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:acaoFundamentadaPorEvidencia hydros:EvidenciaAgronomica_U2_P4,
        hydros:EvidenciaContextual_U2_P4,
        hydros:EvidenciaPreditiva_U2_P4 ;
    hydros:acaoParaUnidade hydros:U_2 .

hydros:AumentarIrrigacao a owl:Class ;
    rdfs:label "Aumentar irrigação"@pt ;
    rdfs:subClassOf hydros:AcaoManejoHidrico .

hydros:CondicaoAdequada a owl:Class ;
    rdfs:label "Condição adequada"@pt ;
    rdfs:subClassOf hydros:CondicaoHidrica ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hydros:CondicaoHidrica [ a owl:Restriction ;
                        owl:hasValue hydros:Regra_Condicao_Adequada ;
                        owl:onProperty hydros:condicaoRelacionadaARegra ] ) ] .

hydros:CondicaoAtencao a owl:Class ;
    rdfs:label "Condição de atenção"@pt ;
    rdfs:subClassOf hydros:CondicaoHidrica ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hydros:CondicaoHidrica [ a owl:Restriction ;
                        owl:hasValue hydros:Regra_Condicao_Atencao ;
                        owl:onProperty hydros:condicaoRelacionadaARegra ] ) ] .

hydros:CondicaoCritica a owl:Class ;
    rdfs:label "Condição crítica"@pt ;
    rdfs:subClassOf hydros:CondicaoHidrica ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( hydros:CondicaoHidrica [ a owl:Restriction ;
                        owl:hasValue hydros:Regra_Condicao_Critica ;
                        owl:onProperty hydros:condicaoRelacionadaARegra ] ) ] .

hydros:Contexto_U2_P1 a hydros:ContextoAgricola,
        owl:NamedIndividual ;
    rdfs:label "Contexto U2 período 1"@pt ;
    hydros:aguaDisponivel 110.0 ;
    hydros:coeficienteCultura 0.75 ;
    hydros:estagioFenologico "V3"^^xsd:string ;
    hydros:estresseHidrico false ;
    hydros:evapotranspiracao 4.1 ;
    hydros:grausDia 18.0 ;
    hydros:irrigacaoAplicada 0.0 ;
    hydros:periodoObservacao 1 ;
    hydros:possuiCondicaoHidrica hydros:Condicao_U2_P1 ;
    hydros:precipitacao 12.0 ;
    hydros:produtividadeEstimada 3850.0 ;
    hydros:temperaturaMedia 29.0 ;
    hydros:umidadeSolo 78.0 .

hydros:Contexto_U2_P2 a hydros:ContextoAgricola,
        owl:NamedIndividual ;
    rdfs:label "Contexto U2 período 2"@pt ;
    hydros:aguaDisponivel 95.0 ;
    hydros:coeficienteCultura 0.78 ;
    hydros:estagioFenologico "V3"^^xsd:string ;
    hydros:estresseHidrico false ;
    hydros:evapotranspiracao 5.0 ;
    hydros:grausDia 22.0 ;
    hydros:irrigacaoAplicada 0.0 ;
    hydros:periodoObservacao 2 ;
    hydros:possuiCondicaoHidrica hydros:Condicao_U2_P2 ;
    hydros:precipitacao 0.0 ;
    hydros:produtividadeEstimada 3820.0 ;
    hydros:temperaturaMedia 33.0 ;
    hydros:umidadeSolo 71.0 .

hydros:Contexto_U2_P3 a hydros:ContextoAgricola,
        owl:NamedIndividual ;
    rdfs:label "Contexto U2 período 3"@pt ;
    hydros:aguaDisponivel 72.0 ;
    hydros:coeficienteCultura 0.82 ;
    hydros:estagioFenologico "V4"^^xsd:string ;
    hydros:estresseHidrico false ;
    hydros:evapotranspiracao 5.8 ;
    hydros:grausDia 25.0 ;
    hydros:irrigacaoAplicada 0.0 ;
    hydros:periodoObservacao 3 ;
    hydros:possuiCondicaoHidrica hydros:Condicao_U2_P3 ;
    hydros:precipitacao 0.0 ;
    hydros:produtividadeEstimada 3740.0 ;
    hydros:temperaturaMedia 35.0 ;
    hydros:umidadeSolo 60.0 .

hydros:Cultura_Soja a hydros:Cultura,
        owl:NamedIndividual ;
    rdfs:label "Soja"@pt .

