hydros:EvidenciaHidrica a owl:Class ;
    rdfs:label "Evidência hídrica"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaHidrica_U2_P4 a hydros:EvidenciaHidrica,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaHidrica U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:EvidenciaHistorica a owl:Class ;
    rdfs:label "Evidência histórica"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaHistorica_U2_P4 a hydros:EvidenciaHistorica,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaHistorica U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:EvidenciaPreditiva a owl:Class ;
    rdfs:label "Evidência preditiva"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaProdutiva a owl:Class ;
    rdfs:label "Evidência produtiva"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaProdutiva_U2_P4 a hydros:EvidenciaProdutiva,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaProdutiva U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:FinalizarIrrigacao a owl:Class ;
    rdfs:label "Finalizar irrigação"@pt ;
    rdfs:subClassOf hydros:AcaoManejoHidrico .

hydros:Historico_U2 a hydros:HistoricoContexto,
        owl:NamedIndividual ;
    rdfs:label "Histórico de contexto da unidade U2"@pt ;
    hydros:possuiContexto hydros:Contexto_U2_P1,
        hydros:Contexto_U2_P2,
        hydros:Contexto_U2_P3,
        hydros:Contexto_U2_P4 .

hydros:Localizacao_U2 a hydros:Localizacao,
        owl:NamedIndividual ;
    rdfs:label "Localização da unidade de manejo 2"@pt .

hydros:ManterIrrigacao a owl:Class ;
    rdfs:label "Manter irrigação"@pt ;
    rdfs:subClassOf hydros:AcaoManejoHidrico .

hydros:ReduzirIrrigacao a owl:Class ;
    rdfs:label "Reduzir irrigação"@pt ;
    rdfs:subClassOf hydros:AcaoManejoHidrico .

hydros:Solo_Argiloso a hydros:Solo,
        owl:NamedIndividual ;
    rdfs:label "Solo argiloso"@pt .

hydros:U_1 a hydros:UnidadeManejo,
        owl:NamedIndividual ;
    rdfs:label "Unidade de manejo 1"@pt ;
    hydros:associadaATalhao hydros:Talhao_1 .

hydros:U_3 a hydros:UnidadeManejo,
        owl:NamedIndividual ;
    rdfs:label "Unidade de manejo 3"@pt ;
    hydros:associadaATalhao hydros:Talhao_3 .

hydros:U_4 a hydros:UnidadeManejo,
        owl:NamedIndividual ;
    rdfs:label "Unidade de manejo 4"@pt ;
    hydros:associadaATalhao hydros:Talhao_4 .

hydros:acaoDeterminadaPor a owl:ObjectProperty ;
    rdfs:label "ação determinada por"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:AgenteInteligente ;
    owl:inverseOf hydros:determinaAcao .

hydros:acaoParaUnidade a owl:ObjectProperty ;
    rdfs:label "ação para unidade"@pt ;
    rdfs:domain hydros:AcaoManejoHidrico ;
    rdfs:range hydros:UnidadeManejo .

hydros:determinaAcao a owl:ObjectProperty ;
    rdfs:label "determina ação"@pt ;
    rdfs:domain hydros:AgenteInteligente ;
    rdfs:range hydros:AcaoManejoHidrico .

hydros:evidenciaProduzidaPor a owl:ObjectProperty ;
    rdfs:label "evidência produzida por"@pt ;
    rdfs:domain hydros:Evidencia ;
    rdfs:range hydros:AgenteInteligente ;
    owl:inverseOf hydros:produzEvidencia .

hydros:periodoObservacao a owl:DatatypeProperty ;
    rdfs:label "período de observação"@pt ;
    rdfs:domain hydros:ContextoAgricola ;
    rdfs:range xsd:integer .

hydros:possuiContexto a owl:ObjectProperty ;
    rdfs:label "possui contexto"@pt ;
    rdfs:domain hydros:HistoricoContexto ;
    rdfs:range hydros:ContextoAgricola .

hydros:possuiContextoDaUnidade a owl:ObjectProperty ;
    rdfs:label "possui contexto da unidade"@pt ;
    rdfs:comment "Propriedade inferida pela cadeia possuiHistoricoContexto o possuiContexto."@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:ContextoAgricola ;
    owl:propertyChainAxiom ( hydros:possuiHistoricoContexto hydros:possuiContexto ) .

hydros:possuiHistoricoContexto a owl:ObjectProperty ;
    rdfs:label "possui histórico de contexto"@pt ;
    rdfs:domain hydros:UnidadeManejo ;
    rdfs:range hydros:HistoricoContexto .

hydros:produzEvidencia a owl:ObjectProperty ;
    rdfs:label "produz evidência"@pt ;
    rdfs:domain hydros:AgenteInteligente ;
    rdfs:range hydros:Evidencia .

hydros:regraRelacionadaACondicao a owl:ObjectProperty ;
    rdfs:label "regra relacionada à condição"@pt ;
    rdfs:domain hydros:RegraAgronomica ;
    rdfs:range hydros:CondicaoHidrica .

hydros:Condicao_U2_P1 a hydros:CondicaoHidrica,
        owl:NamedIndividual ;
    rdfs:label "Condição hídrica U2 período 1"@pt .

hydros:Condicao_U2_P2 a hydros:CondicaoHidrica,
        owl:NamedIndividual ;
    rdfs:label "Condição hídrica U2 período 2"@pt .

hydros:Condicao_U2_P3 a hydros:CondicaoHidrica,
        owl:NamedIndividual ;
    rdfs:label "Condição hídrica U2 período 3"@pt .

hydros:Cultura a owl:Class ;
    rdfs:label "Cultura"@pt ;
    rdfs:comment "Cultura agrícola associada à unidade de manejo."@pt .

hydros:EvidenciaAgronomica_U2_P4 a hydros:EvidenciaAgronomica,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaAgronomica U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:EvidenciaContextual_U2_P4 a hydros:EvidenciaContextual,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaContextual U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:EvidenciaPreditiva_U2_P4 a hydros:EvidenciaPreditiva,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaPreditiva U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
    hydros:evidenciaSobre hydros:U_2 .

hydros:IniciarIrrigacao a owl:Class ;
    rdfs:label "Iniciar irrigação"@pt ;
    rdfs:subClassOf hydros:AcaoManejoHidrico .

hydros:Localizacao a owl:Class ;
    rdfs:label "Localização"@pt ;
    rdfs:comment "Descritores espaciais associados à unidade de manejo."@pt .

hydros:Regra_Condicao_Adequada a hydros:RegraAgronomica,
        owl:NamedIndividual ;
    rdfs:label "Regra para condição adequada"@pt ;
    hydros:regraRelacionadaACondicao hydros:Condicao_U2_P1,
        hydros:Condicao_U2_P2 .

hydros:Regra_Condicao_Atencao a hydros:RegraAgronomica,
        owl:NamedIndividual ;
    rdfs:label "Regra para condição de atenção"@pt ;
    hydros:regraRelacionadaACondicao hydros:Condicao_U2_P3 .

hydros:Solo a owl:Class ;
    rdfs:label "Solo"@pt ;
    rdfs:comment "Características edáficas relevantes para o gerenciamento hídrico."@pt .

hydros:Talhao_1 a hydros:Talhao,
        owl:NamedIndividual ;
    rdfs:label "Talhão 1"@pt .

hydros:Talhao_2 a hydros:Talhao,
        owl:NamedIndividual ;
    rdfs:label "Talhão 2"@pt .

hydros:Talhao_3 a hydros:Talhao,
        owl:NamedIndividual ;
    rdfs:label "Talhão 3"@pt .

hydros:Talhao_4 a hydros:Talhao,
        owl:NamedIndividual ;
    rdfs:label "Talhão 4"@pt .

hydros:Condicao_U2_P4 a hydros:CondicaoHidrica,
        owl:NamedIndividual ;
    rdfs:label "Condição hídrica U2 período 4"@pt .

hydros:HistoricoContexto a owl:Class ;
    rdfs:label "Histórico de contexto"@pt ;
    rdfs:comment "Sequência temporal de contextos de uma unidade de manejo."@pt .

hydros:PropriedadeAgricola a owl:Class ;
    rdfs:label "Propriedade agrícola"@pt ;
    rdfs:comment "Representa uma propriedade agrícola."@pt .

hydros:Regra_Condicao_Critica a hydros:RegraAgronomica,
        owl:NamedIndividual ;
    rdfs:label "Regra para condição crítica"@pt ;
    hydros:regraRelacionadaACondicao hydros:Condicao_U2_P4 .

hydros:condicaoRelacionadaARegra a owl:ObjectProperty ;
    rdfs:label "condição relacionada à regra"@pt ;
    rdfs:domain hydros:CondicaoHidrica ;
    rdfs:range hydros:RegraAgronomica ;
    owl:inverseOf hydros:regraRelacionadaACondicao .

hydros:Talhao a owl:Class ;
    rdfs:label "Talhão"@pt ;
    rdfs:comment "Representa uma divisão espacial reconhecida no domínio agrícola."@pt .

hydros:RegraAgronomica a owl:Class ;
    rdfs:label "Regra agronômica"@pt ;
    rdfs:comment "Conhecimento agronômico explícito utilizado no processamento."@pt .

hydros:Contexto_U2_P4 a hydros:ContextoAgricola,
        owl:NamedIndividual ;
    rdfs:label "Contexto U2 período 4"@pt ;
    hydros:aguaDisponivel 50.0 ;
    hydros:coeficienteCultura 0.86 ;
    hydros:estagioFenologico "V4"^^xsd:string ;
    hydros:estresseHidrico true ;
    hydros:evapotranspiracao 6.2 ;
    hydros:grausDia 27.0 ;
    hydros:irrigacaoAplicada 0.0 ;
    hydros:periodoObservacao 4 ;
    hydros:possuiCondicaoHidrica hydros:Condicao_U2_P4 ;
    hydros:precipitacao 0.0 ;
    hydros:produtividadeEstimada 3610.0 ;
    hydros:temperaturaMedia 36.0 ;
    hydros:umidadeSolo 48.0 .

hydros:U_2 a hydros:UnidadeManejo,
        owl:NamedIndividual ;
    rdfs:label "Unidade de manejo 2"@pt ;
    hydros:associadaATalhao hydros:Talhao_2 ;
    hydros:possuiCultura hydros:Cultura_Soja ;
    hydros:possuiHistoricoContexto hydros:Historico_U2 ;
    hydros:possuiLocalizacao hydros:Localizacao_U2 ;
    hydros:possuiSolo hydros:Solo_Argiloso .

hydros:AcaoManejoHidrico a owl:Class ;
    rdfs:label "Ação de manejo hídrico"@pt ;
    rdfs:comment "Ação de manejo determinada pelo Hydros."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hydros:acaoParaUnidade ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hydros:acaoDeterminadaPor ] .

hydros:CondicaoHidrica a owl:Class ;
    rdfs:label "Condição hídrica"@pt ;
    rdfs:comment "Interpretação semântica da condição hídrica de um contexto."@pt .

hydros:Evidencia a owl:Class ;
    rdfs:label "Evidência"@pt ;
    rdfs:comment "Resultado produzido durante o processamento do Hydros."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hydros:evidenciaProduzidaPor ] .

hydros:UnidadeManejo a owl:Class ;
    rdfs:label "Unidade de manejo"@pt ;
    rdfs:comment "Entidade operacional analisada pelo Hydros."@pt .

hydros:AgenteInteligente a owl:Class ;
    rdfs:label "Agente inteligente"@pt ;
    rdfs:comment "Classe usada para registrar proveniência de evidências e ações."@pt .

hydros:ContextoAgricola a owl:Class ;
    rdfs:label "Contexto agrícola"@pt ;
    rdfs:comment "Condições observadas em determinado período."@pt ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty hydros:periodoObservacao ] .

[] a owl:AllDisjointClasses ;
    owl:members ( hydros:CondicaoAdequada hydros:CondicaoAtencao hydros:CondicaoCritica ) .

[] a owl:AllDisjointClasses ;
    owl:members ( hydros:IniciarIrrigacao hydros:ManterIrrigacao hydros:AumentarIrrigacao hydros:ReduzirIrrigacao hydros:FinalizarIrrigacao ) .

