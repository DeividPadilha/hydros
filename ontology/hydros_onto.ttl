hydros:EvidenciaGeografica_U2_P4 a hydros:EvidenciaGeografica,
        owl:NamedIndividual ;
    rdfs:label "EvidenciaGeografica U2 P4"@pt ;
    hydros:evidenciaConsideraContexto hydros:Contexto_U2_P4 ;
