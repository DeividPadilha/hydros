hydros:EvidenciaFenologica a owl:Class ;
    rdfs:label "Evidência fenológica"@pt ;
    rdfs:subClassOf hydros:Evidencia .

hydros:EvidenciaFenologica_U2_P4 a hydros:EvidenciaFenologica,
